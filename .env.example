# GigaAM ASR — пример конфигурации. Скопируйте в `.env` и отредактируйте при необходимости.
# Полный справочник переменных — в README (раздел «Конфигурация»).

# --- Модель и устройство ---
# Имя модели GigaAM (должно входить в ALLOWED_MODELS).
MODEL=v3_ctc
# Устройство инференса: auto|cpu|mps|cuda. auto: cuda→mps→cpu.
DEVICE=auto

# --- Аутентификация ---
# Bearer-ключ для OpenAI-совместимых клиентов. Пусто → auth выключен (в проде задайте).
API_KEY=

# --- Веса и ресурсы ---
# Каталог кэша весов. Дефолт /data/models — для контейнера (смонтированный volume,
# хостовый ./models должен принадлежать UID 1000). На нативном dev-Mac укажите доступный
# путь, напр. ./models или ~/.cache/gigaam. Передаётся в download_root модели GigaAM.
MODELS_DIR=/data/models
# Динамическая int8-квантизация (этап 07).
QUANTIZE_INT8=false
# Размер батча longform-инференса.
BATCH_SIZE=4
# torch.set_num_threads (число потоков CPU-инференса).
NUM_THREADS=4

# --- Автовыгрузка модели из памяти ---
# Если модель не использовалась столько секунд — она выгружается из памяти и загрузится
# снова при следующем запросе (веса берутся из кэша MODELS_DIR, без сети).
# 0 — выключено (модель всегда в памяти). Рантайм-значение можно менять на странице UI.
IDLE_UNLOAD_SECONDS=300

# --- Лимиты загрузки ---
# Лимит размера загружаемого файла, МБ.
MAX_UPLOAD_MB=2048
# Лимит длительности аудио, секунд (10ч). 0 = без лимита.
MAX_AUDIO_SECONDS=36000
# Лимит очереди инференса (в очереди + в работе). Сверх — HTTP 503.
MAX_QUEUE=8

# --- VAD / чанкинг (этап 03) ---
# Мин. длина сегмента, сек.
VAD_MIN_DURATION=15.0
# Целевой максимум длины сегмента, сек.
VAD_MAX_DURATION=22.0
# Жёсткий максимум, сек (сверх — принудительный порез).
VAD_STRICT_LIMIT=30.0
# Порог нового чанка, сек.
VAD_NEW_CHUNK_THRESHOLD=0.2
# Silero VAD: порог вероятности речи (ниже = больше контекста на чанк; оптимум 0.2-0.3, не ниже 0.2).
VAD_THRESHOLD=0.25

# --- HTTP-сервер ---
# Хост uvicorn (основной API).
HOST=0.0.0.0
# Порт (основной API).
PORT=8000

# --- Веб-панель управления (отдельный порт) ---
# Включить панель управления (автовыгрузка/ручная выгрузка модели).
UI_ENABLED=true
# Хост панели управления.
UI_HOST=0.0.0.0
# Порт панели управления.
UI_PORT=8001

# --- Логирование ---
# Уровень логов: DEBUG|INFO|WARNING|ERROR.
LOG_LEVEL=INFO
# true → компактный JSON-формат логов, иначе human-readable.
LOG_JSON=false

# --- API ---
# Формат ответа по умолчанию: json|text|verbose_json|srt|vtt.
DEFAULT_RESPONSE_FORMAT=json
# Допустимые значения поля `model` (CSV).
ALLOWED_MODELS=v3_ctc,v3_e2e_ctc,v3_rnnt,v3_e2e_rnnt
